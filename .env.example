# Doubao batch dictation configuration.
#
# Copy to ~/.config/doubao-dictate/.env and fill in DOUBAO_API_KEY.
# Lookup order: $DOUBAO_DICTATE_ENV, ~/.config/doubao-dictate/.env, ./.env
# Real environment variables override values in this file.
# Never commit your key.

# --- API ---
DOUBAO_API_KEY=
# Non-stream (one-shot) endpoint: the whole utterance is sent after you stop.
DOUBAO_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
DOUBAO_RESOURCE_ID=volc.seedasr.sauc.duration

# --- Audio ---
# "default" follows the system default source, or a PulseAudio source name.
DOUBAO_DEVICE=default
DOUBAO_SAMPLE_RATE=16000
# PCM chunk size sent per audio frame.
DOUBAO_SEGMENT_MS=200
# Safety cap; recording stops by itself after this many seconds.
DOUBAO_MAX_DURATION_SECS=120

# --- Output ---
# "type" (types at the cursor through the built-in Wayland keyboard) or
# "clipboard" (wl-copy).
DOUBAO_MODE=type
# Pause between typed characters, in milliseconds. Raise it if a rare
# application drops characters while typing.
DOUBAO_TYPE_DELAY_MS=10

# --- Feedback ---
DOUBAO_NOTIFY=true
